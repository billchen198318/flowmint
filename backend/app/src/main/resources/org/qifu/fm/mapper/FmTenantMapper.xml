<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.qifu.fm.mapper.FmTenantMapper">
  <resultMap id="BaseResultMap" type="org.qifu.fm.entity.FmTenant">
    <id column="OID" jdbcType="CHAR" property="oid" />
    <result column="TENANT_ID" jdbcType="VARCHAR" property="tenantId" />
    <result column="TENANT_CODE" jdbcType="VARCHAR" property="tenantCode" />
    <result column="TENANT_NAME" jdbcType="VARCHAR" property="tenantName" />
    <result column="DEFAULT_LOCALE" jdbcType="VARCHAR" property="defaultLocale" />
    <result column="DEFAULT_TIMEZONE" jdbcType="VARCHAR" property="defaultTimezone" />
    <result column="STATUS" jdbcType="VARCHAR" property="status" />
    <result column="DESCRIPTION" jdbcType="VARCHAR" property="description" />
    <result column="CUSERID" jdbcType="VARCHAR" property="cuserid" />
    <result column="CDATE" jdbcType="TIMESTAMP" property="cdate" />
    <result column="UUSERID" jdbcType="VARCHAR" property="uuserid" />
    <result column="UDATE" jdbcType="TIMESTAMP" property="udate" />
  </resultMap>

  <select id="selectByPrimaryKey" parameterType="java.lang.String" resultMap="BaseResultMap">
    SELECT * FROM <include refid="org.qifu.core.mapper.DB1Config.schema"/>fm_tenant WHERE OID = #{oid,jdbcType=CHAR}
  </select>

  <sql id="baseConditions">
    <if test="tenantId != null and tenantId != ''.toString()">
      AND TENANT_ID = #{tenantId,jdbcType=VARCHAR}
    </if>
    <if test="tenantCode != null and tenantCode != ''.toString()">
      AND TENANT_CODE = #{tenantCode,jdbcType=VARCHAR}
    </if>
    <if test="tenantCodeLike != null and tenantCodeLike != ''.toString()">
      AND TENANT_CODE LIKE #{tenantCodeLike,jdbcType=VARCHAR}
    </if>
    <if test="tenantNameLike != null and tenantNameLike != ''.toString()">
      AND TENANT_NAME LIKE #{tenantNameLike,jdbcType=VARCHAR}
    </if>
    <if test="status != null and status != ''.toString()">
      AND STATUS = #{status,jdbcType=VARCHAR}
    </if>
  </sql>

  <select id="selectListByParams" parameterType="java.util.HashMap" resultMap="BaseResultMap">
    SELECT * FROM <include refid="org.qifu.core.mapper.DB1Config.schema"/>fm_tenant WHERE 1 = 1
    <include refid="baseConditions" />
    <if test="orderBy != null and orderBy != ''.toString() and sortType != null and sortType != ''.toString()">
      ORDER BY ${orderBy} ${sortType}
    </if>
  </select>

  <select id="findPage" parameterType="java.util.HashMap" resultMap="BaseResultMap">
    <include refid="org.qifu.core.mapper.DB1Config.sql1"/>
    SELECT * FROM <include refid="org.qifu.core.mapper.DB1Config.schema"/>fm_tenant WHERE 1 = 1
    <include refid="baseConditions" />
    <include refid="org.qifu.core.mapper.DB1Config.sql2"/>
  </select>

  <select id="count" parameterType="java.util.HashMap" resultType="java.lang.Long">
    SELECT COUNT(*) FROM <include refid="org.qifu.core.mapper.DB1Config.schema"/>fm_tenant WHERE 1 = 1
    <include refid="baseConditions" />
  </select>

  <insert id="insert" parameterType="org.qifu.fm.entity.FmTenant">
    INSERT INTO <include refid="org.qifu.core.mapper.DB1Config.schema"/>fm_tenant
      (OID, TENANT_ID, TENANT_CODE, TENANT_NAME, DEFAULT_LOCALE, DEFAULT_TIMEZONE, STATUS, DESCRIPTION, CUSERID, CDATE)
    VALUES
      (#{oid,jdbcType=CHAR}, #{tenantId,jdbcType=VARCHAR}, #{tenantCode,jdbcType=VARCHAR}, #{tenantName,jdbcType=VARCHAR},
       #{defaultLocale,jdbcType=VARCHAR}, #{defaultTimezone,jdbcType=VARCHAR}, #{status,jdbcType=VARCHAR}, #{description,jdbcType=VARCHAR},
       #{cuserid,jdbcType=VARCHAR}, #{cdate,jdbcType=TIMESTAMP})
  </insert>

  <update id="update" parameterType="org.qifu.fm.entity.FmTenant">
    UPDATE <include refid="org.qifu.core.mapper.DB1Config.schema"/>fm_tenant
       SET TENANT_CODE = #{tenantCode,jdbcType=VARCHAR},
           TENANT_NAME = #{tenantName,jdbcType=VARCHAR},
           DEFAULT_LOCALE = #{defaultLocale,jdbcType=VARCHAR},
           DEFAULT_TIMEZONE = #{defaultTimezone,jdbcType=VARCHAR},
           STATUS = #{status,jdbcType=VARCHAR},
           DESCRIPTION = #{description,jdbcType=VARCHAR},
           UUSERID = #{uuserid,jdbcType=VARCHAR},
           UDATE = #{udate,jdbcType=TIMESTAMP}
     WHERE OID = #{oid,jdbcType=CHAR}
  </update>

  <delete id="delete" parameterType="org.qifu.fm.entity.FmTenant">
    DELETE FROM <include refid="org.qifu.core.mapper.DB1Config.schema"/>fm_tenant WHERE OID = #{oid,jdbcType=CHAR}
  </delete>
</mapper>